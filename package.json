{
  "name": "nextjs-convex-monorepo-template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -c -- turbo run dev",
    "predev": "pnpm --filter @repo/convex bootstrap",
    "init-template": "node scripts/init.mjs",
    "build": "dotenv -c -- turbo run build",
    "build:with-convex-deploy": "pnpm exec convex deploy --cmd 'pnpm run build' --cmd-url-env-var-name NEXT_PUBLIC_CONVEX_URL",
    "start": "dotenv -c -- turbo run start --filter=@repo/web",
    "lint": "dotenv -c -- turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test:e2e": "dotenv -c -- pnpm --filter @repo/e2e test",
    "test:e2e:ui": "dotenv -c -- pnpm --filter @repo/e2e test:ui",
    "test:e2e:debug": "dotenv -c -- pnpm --filter @repo/e2e test:debug",
    "test:storage": "dotenv -c -- pnpm --filter @repo/convex test:storage",
    "seed:user": "dotenv -c -- pnpm --filter @repo/convex seed:user",
    "seed:all": "dotenv -c -- pnpm --filter @repo/convex seed:all"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@convex-dev/auth": "^0.0.92",
    "@t3-oss/env-core": "^0.13.11",
    "@t3-oss/env-nextjs": "^0.13.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.39.1",
    "convex-helpers": "^0.1.118",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.8.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "^2.0.0",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "npm-run-all2": "^9.0.1",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.5.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.33.0+sha256.bfcc1bcbad279b13a516c446a75b3c58b6904b45d57a1951411015e50b751a80",
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx,json,css,md}": "prettier --write"
  }
}

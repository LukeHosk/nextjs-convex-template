# Convex deployment — from https://dashboard.convex.dev
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Set by setup.mjs on first run
SETUP_SCRIPT_RAN=1

# Seed API endpoint protection (used by /api/seed route and seed-preview CI workflow)
SEED_SECRET=

# Seed user credentials (defaults used if not set)
SEED_USER_EMAIL=test@example.test
SEED_USER_PASSWORD=TestPass123!
SEED_USER_2_EMAIL=test2@example.test
SEED_USER_2_PASSWORD=TestPass123!
